# Infotag Autonomous Automation Environment Variables

# GitHub Authentication (In GitHub Actions, GITHUB_TOKEN is automatically provided)
GITHUB_TOKEN=

# Optional AI Model Provider Keys (Deterministic verification operates automatically if unconfigured)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Publishing Configuration
INFOTAG_TIMEZONE=Africa/Nairobi
INFOTAG_PUBLISHING_INTERVAL_HOURS=72.0
INFOTAG_PROVIDER_NAME=ChatGPT
INFOTAG_PROVIDER_SLUG=chatgpt
